# ─────────────────────────────────────────────────────────────
#  Database Configuration (PostgreSQL)
# ─────────────────────────────────────────────────────────────
#  This project uses PostgreSQL (not MySQL).
#
#  Local PostgreSQL:
#    postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
#
#  Cloud PostgreSQL (Neon / Supabase / Railway):
#    postgresql://USER:PASSWORD@ep-xyz.region.neon.tech/neondb?sslmode=require
#
#  Need a database? Run this once as a PostgreSQL superuser:
#    CREATE ROLE my_app_user LOGIN PASSWORD 'your_password';
#    CREATE DATABASE my_app_db OWNER my_app_user;
#
DATABASE_URL=postgresql://postgres:password123@localhost:5432/next_job_portal
